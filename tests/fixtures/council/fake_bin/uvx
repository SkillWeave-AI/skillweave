#!/usr/bin/env python3
"""A harmless fake ``uvx`` that records any launch attempt (SW-COUNCIL-003, criterion 2).

The criterion-2 regressions must prove that a *refused* launcher command spawns
**nothing**. This program is pointed at by a refused command (through
``COUNCIL_REFUSAL_FAKE_LAUNCHER``), so the only way its side effect can appear is
if a process was actually launched with it. It writes nothing to stdout/stderr and
touches no network; it merely appends its argv to the log named by
``COUNCIL_REFUSAL_ARGV_LOG`` (falling back to a temp file, never a path beside
this fixture in the source tree), then exits non-zero to look nothing like a
working MCP server.

Because the file is named ``uvx``, the launcher resolver's uvx-spec detection
applies to a command whose first element is this path -- exactly the "unpinned
``uvx`` spec" refusal the criterion calls for.
"""

import os
import sys
import tempfile
from pathlib import Path

log_path = os.environ.get("COUNCIL_REFUSAL_ARGV_LOG") or str(
    Path(tempfile.gettempdir()) / "council-refusal-argv.log"
)
try:
    with open(log_path, "a", encoding="utf-8") as handle:
        handle.write(" ".join(sys.argv) + "\n")
except OSError:
    pass
sys.exit(3)
