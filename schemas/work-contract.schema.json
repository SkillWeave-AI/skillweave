{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillweave.dev/schemas/work-contract/v1",
  "title": "Work Contract Schema (SW-159-GENERIC-001)",
  "description": "Generic work contract with discriminated SubjectRef, EvidenceReceipt, capability attestation, authority, write scope, irreversible actions, verification, rollback, budget, methodology, policy, and exact-brief digest",
  "type": "object",
  "required": ["id", "subject", "authority"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Work contract identifier"
    },
    "subject": {
      "$ref": "#/$defs/subjectRef"
    },
    "authority": {
      "type": "string",
      "enum": ["controller", "ops", "reviewer", "observer", "integrator"],
      "description": "Single authority role for this unit of work"
    },
    "write_scope": {
      "$ref": "#/$defs/writeScope"
    },
    "irreversible_actions": {
      "type": "array",
      "items": {"$ref": "#/$defs/irreversibleAction"}
    },
    "verification": {
      "type": "array",
      "items": {"$ref": "#/$defs/verificationClause"}
    },
    "rollback": {
      "type": "string",
      "description": "Rollback plan; 'none: <reason>' when no rollback exists"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "methodology": {
      "type": "string",
      "description": "Named methodology the work follows"
    },
    "policy": {
      "type": "string",
      "description": "Policy digest or reference governing the work"
    },
    "evidence_required": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Evidence types required for this contract"
    },
    "brief_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 content address of the exact submitted brief bytes"
    },
    "brief_byte_length": {
      "type": "integer",
      "minimum": 0,
      "description": "Byte length of the exact submitted brief"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "subjectRef": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["repository", "content", "configuration", "deployment", "incident"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "repository"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["repo", "commit"],
            "properties": {
              "repo": {"type": "string", "minLength": 1},
              "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "content"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["channel", "content_id", "revision"],
            "properties": {
              "channel": {"type": "string", "minLength": 1},
              "content_id": {"type": "string", "minLength": 1},
              "revision": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "configuration"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["config_id", "environment", "version"],
            "properties": {
              "config_id": {"type": "string", "minLength": 1},
              "environment": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "deployment"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["target", "environment", "artifact_digest"],
            "properties": {
              "target": {"type": "string", "minLength": 1},
              "environment": {"type": "string", "minLength": 1},
              "artifact_digest": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "incident"}},
            "required": ["kind"]
          },
          "then": {
            "required": ["incident_id", "state", "severity"],
            "properties": {
              "incident_id": {"type": "string", "minLength": 1},
              "state": {"type": "string", "minLength": 1},
              "severity": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "evidenceReceipt": {
      "type": "object",
      "required": ["subject", "artifact_digest", "evidence_type"],
      "properties": {
        "subject": {"$ref": "#/$defs/subjectRef"},
        "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "evidence_type": {"type": "string", "minLength": 1},
        "purpose": {"type": "string"},
        "method": {"type": "string"},
        "producer": {"type": "string"},
        "observed_at": {"type": "string"},
        "subject_identity": {"type": "string"}
      },
      "additionalProperties": false
    },
    "writeScope": {
      "type": "object",
      "required": ["kind", "allow"],
      "properties": {
        "kind": {"type": "string"},
        "allow": {"type": "array", "items": {"type": "string"}},
        "deny": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "irreversibleAction": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "release", "deploy", "prod", "publish", "push", "tag",
            "package_sign", "finance", "legal", "public_channel",
            "human", "organization"
          ]
        },
        "authorization": {"type": "string"},
        "rollback": {"type": "string"}
      },
      "additionalProperties": false
    },
    "verificationClause": {
      "type": "object",
      "required": ["method", "evidence_type"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "evidence_type": {"type": "string", "minLength": 1},
        "command": {"type": "string"}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["max_correction_rounds", "max_attempts"],
      "properties": {
        "max_correction_rounds": {"type": "integer", "minimum": 0},
        "max_attempts": {"type": "integer", "minimum": 1},
        "max_steps": {"type": ["integer", "null"]}
      },
      "additionalProperties": false
    }
  }
}
