{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DispatchSequence",
  "description": "The operator dispatch sequence contract consumed by the wave dispatcher (SW138-CONTRACT-001). It binds the session boundary, an explicit profile reference, the execution model, the correction budget, and per-lane repo plus full base SHA. It names no model or harness default and carries no duration-estimate field.",
  "type": "object",
  "required": [
    "session_boundary",
    "profile",
    "execution_model",
    "max_correction_rounds_per_wave",
    "max_parallel",
    "lanes"
  ],
  "properties": {
    "session_boundary": {
      "type": "string",
      "enum": ["batch"]
    },
    "profile": {
      "$ref": "#/$defs/profileReference"
    },
    "execution_model": {
      "type": "string",
      "enum": ["cold", "warm", "resume"]
    },
    "max_correction_rounds_per_wave": {
      "type": "integer",
      "minimum": 0
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1
    },
    "model_policy": {
      "$ref": "#/$defs/modelPolicy"
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "methodology": {
      "type": "string",
      "enum": ["rex", "ralph", "gauntlet", "assay"],
      "description": "The execution methodology, named separately from its autonomy policy and session schedule (SW-1510-SKILLS). The legacy execution_model vocabulary is an explicit adapter and never a silent substitution."
    },
    "autonomy_policy": {
      "type": "string",
      "enum": ["conservative", "medium", "unicorn", ""]
    },
    "session_schedule": {
      "type": "string",
      "minLength": 1
    },
    "execution_envelope": {
      "$ref": "#/$defs/executionEnvelope"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "modelPolicy": {
      "type": "object",
      "description": "The provider-neutral model-policy declaration: capability/minimum tier, architectural risk, cost ceiling and fallback, without any vendor/gateway prefix. The minimum tier is flash or pro (capability classes, not product names).",
      "properties": {
        "minimum_tier": {
          "type": "string",
          "enum": ["flash", "pro"]
        },
        "architectural_risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "cost_ceiling": {
          "type": "number"
        },
        "fallback": {
          "type": "string",
          "enum": ["block", "escalate"]
        },
        "requires": {
          "type": "object",
          "properties": {
            "architecture": { "type": "boolean" },
            "high_blast_radius": { "type": "boolean" },
            "migration": { "type": "boolean" },
            "security": { "type": "boolean" },
            "causal_verification": { "type": "boolean" },
            "ambiguous_rework": { "type": "boolean" },
            "critical_review": { "type": "boolean" }
          }
        }
      },
      "additionalProperties": false
    },
    "profileReference": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/profileProvenance"
        }
      },
      "additionalProperties": false
    },
    "profileProvenance": {
      "type": "object",
      "description": "The four profile identity fields a chain and its receipts carry end to end (SW1312-CHAIN-001): the profile id, its artifact version, the SDK schema digest it was bound to, and the immutable effective-profile content digest. Each is a non-empty string; an explicit profile selection must bind all four so a later run can re-trace which snapshot produced the chain.",
      "required": [
        "profile_id",
        "profile_version",
        "sdk_digest",
        "effective_digest"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "sdk_digest": {
          "type": "string",
          "minLength": 1
        },
        "effective_digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "lane": {
      "type": "object",
      "required": [
        "id",
        "role",
        "repo",
        "base",
        "execution_model"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "execution_model": {
          "type": "string",
          "enum": ["cold", "warm", "resume"]
        },
        "mutating": {
          "type": "boolean"
        },
        "criterion_groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterionGroup"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "write_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "worktree": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "integration_policy": {
          "type": "string",
          "enum": ["independent", "requires_integrator"]
        },
        "harness_state_namespace": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "criterionGroup": {
      "type": "object",
      "required": ["criteria"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "dispatchEvent": {
      "type": "object",
      "required": [
        "run_id",
        "wave",
        "lane_id",
        "dispatch_id",
        "sequence",
        "timestamp",
        "event_type",
        "process_status",
        "task_status"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "wave": {
          "type": "string",
          "minLength": 1
        },
        "lane_id": {
          "type": "string",
          "minLength": 1
        },
        "dispatch_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "event_type": {
          "type": "string",
          "minLength": 1
        },
        "process_status": {
          "type": "string",
          "minLength": 1
        },
        "task_status": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "type": "string"
        },
        "receipt_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "practiceTask": {
      "type": "object",
      "required": [
        "id",
        "acceptanceCriteria",
        "points",
        "dependsOn",
        "lane"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "points": {
          "type": "integer",
          "enum": [1, 2, 3, 5, 8, 13]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lane": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "executionEnvelope": {
      "type": "object",
      "title": "execution-envelope-v1",
      "description": "The namespaced execution-envelope-v1 block (SW-1510-SKILLS): methodology, autonomy_policy and session_schedule as three separate fields, plus the explicit legacy adapter provenance.",
      "required": ["version", "methodology", "autonomy_policy", "session_schedule"],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "methodology": {
          "type": "string",
          "enum": ["rex", "ralph", "gauntlet", "assay"]
        },
        "autonomy_policy": {
          "type": "string",
          "enum": ["conservative", "medium", "unicorn", ""]
        },
        "session_schedule": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": ["declared", "legacy"]
        },
        "legacy_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "subject_kind": {
          "type": "string",
          "enum": ["configuration"]
        },
        "schema_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
