{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Requirements Document (PRD)",
  "description": "Structured PRD format adapted from Ralph Loop principles for multi-agent AI development. This schema describes the format the SkillWeave ecosystem produces (see scripts/regen-sequence.py as the de facto contract). Effort is expressed as Fibonacci complexity points; there is no time-estimate field.\n\nCANONICAL PRD FORM (recorded 2026-09-01, SW152-015): the form this schema describes is the single house form. It is the projectName / acceptanceCriteria / points / dependsOn / lane form (Form B), not the legacy project / acceptance_criteria / complexity_points / agent_type / verification_steps form (Form A). Reason: Form B is the only form the shipped tooling consumes — regen-sequence.py reads projectName, acceptanceCriteria, points, dependsOn and lane and writes zero dispatches for Form A — and it is the form every production planning PRD already uses. Form A lives only in two pre-1.3.6 planning documents, which are recorded as known exceptions (see the exceptions note below).\n\n$SCHEMA POINTER: the canonical location of this file is skills/skillweave-blueprint/assets/prd.schema.json. A PRD may point at it with \"$schema\": \"../../skills/skillweave-blueprint/assets/prd.schema.json\" when its own path is under a repository root; it must not point at .skillweave/schemas/prd.schema.json, which has never existed in any repository. A PRD that carries no \"$schema\" key is also valid: the pointer is optional, and a dangling pointer is worse than none.\n\nKNOWN EXCEPTIONS (PRDs that do not validate against this schema, recorded with reason): two pre-1.3.6 planning documents — both are written in Form A, predate 1.3.6, and remain as historical planning documents; converting them to Form B is mechanical but outside the schema's authority.",
  "type": "object",
  "required": ["projectName", "tasks"],
  "properties": {
    "projectName": {
      "type": "string",
      "description": "Project name (used by regen-sequence.py to title generated artifacts)"
    },
    "version": {
      "type": "string",
      "description": "PRD version (semantic versioning recommended)"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "ready", "approved", "active", "completed", "archived"],
      "description": "PRD status. 'ready' is the state a PRD carries the moment it is dispatched and is the single most common value across the planning repositories."
    },
    "sequence": {
      "type": "object",
      "description": "Execution sequence metadata consumed by regen-sequence.py and promptchain-execute. Required by the tool — see planning/scripts/regen-sequence.py.",
      "properties": {
        "sequence_id": { "type": "string" },
        "sequence_type": {
          "type": "string",
          "enum": ["build", "plan", "mixed"]
        },
        "execution_mode": { "type": "string" },
        "session_boundary": {
          "type": "string",
          "enum": ["batch", "phase", "none"],
          "description": "Where a session is allowed to stop and resume. promptchain-validate and promptchain-execute key off this."
        },
        "worktree": { "type": "string" },
        "branch": { "type": "string" },
        "base": { "type": "string" },
        "state_file": { "type": "string" },
        "runner_shell": { "type": "string" },
        "phase_names": {
          "type": "object",
          "description": "Map of level number to phase name, e.g. {\"0\": \"fix-the-tool\"}",
          "additionalProperties": { "type": "string" }
        },
        "parallel_lanes": {
          "type": "array",
          "description": "Phases declared to run lanes as subagents concurrently",
          "items": { "type": "object" }
        },
        "exclusive": {
          "type": "array",
          "description": "Surfaces written by more than one task - mutual exclusion that dependsOn cannot express",
          "items": {
            "type": "object",
            "required": ["surface", "tasks"],
            "properties": {
              "surface": { "type": "string" },
              "tasks": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum iterations for Ralph Loop"
        },
        "timeout_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440,
          "description": "Timeout in minutes for execution"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["planning", "code_generation", "testing", "review", "research", "automation", "infrastructure", "any"]
          },
          "description": "Required agent capabilities for execution (planning, code_generation, testing, review, etc.)"
        },
        "verification_level": {
          "type": "string",
          "enum": ["basic", "standard", "strict", "production"],
          "description": "Verification strictness level"
        },
        "completion_promise": {
          "type": "string",
          "description": "Completion promise format",
          "default": "<skillweave-complete>\nstatus: success\ntask: {task_id}\ntimestamp: {timestamp}\n</skillweave-complete>"
        },
        "memory_format": {
          "type": "string",
          "enum": ["yaml", "json", "markdown"],
          "description": "Memory file format",
          "default": "yaml"
        }
      },
      "additionalProperties": false
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "priority"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Objective ID"
          },
          "description": {
            "type": "string",
            "description": "Objective description"
          },
          "priority": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"],
            "description": "Priority level"
          },
          "success_metrics": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["metric", "target", "measurement"],
              "properties": {
                "metric": {
                  "type": "string",
                  "description": "Metric name"
                },
                "target": {
                  "type": "string",
                  "description": "Target value"
                },
                "measurement": {
                  "type": "string",
                  "description": "How to measure"
                },
                "baseline": {
                  "type": "string",
                  "description": "Current baseline value"
                }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "acceptanceCriteria", "priority", "type", "points"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+[-A-Z0-9]+$",
            "description": "Task ID (e.g., INFRA-001, OPS-002-R, CORE-000-1); prefix plus dashed alphanumeric sections"
          },
          "title": {
            "type": "string",
            "description": "Task title"
          },
          "description": {
            "type": "string",
            "description": "Detailed task description"
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3", "critical", "high", "medium", "low"],
            "description": "Priority level"
          },
          "points": {
            "type": "integer",
            "enum": [1, 2, 3, 5, 8, 13, 21],
            "description": "Effort in Fibonacci complexity points. The ecosystem dropped time estimates (they were assumptions without a measurement basis); practice uses complexity. regen-sequence.py and dispatch briefs read this."
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+[-A-Z0-9]+$"
            },
            "description": "Task IDs this task depends on"
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "description": "Binary, testable acceptance criterion"
            }
          },
          "type": {
            "type": "string",
            "enum": ["bug", "bugfix", "feature", "refactor", "task", "research", "review", "verification", "infrastructure", "docs"],
            "description": "Task type. 'research' is the type a PRD uses for a task whose deliverable is a measurement or finding rather than code."
          },
          "passes": {
            "type": "boolean",
            "description": "Whether task has passed verification",
            "default": false
          },
          "repo": {
            "type": "string",
            "description": "Repository this task runs in, when the PRD spans multiple repositories"
          },
          "lane": {
            "type": "object",
            "description": "Dispatch/lane block consumed by regen-sequence.py and promptchain-execute",
            "properties": {
              "creates": {
                "type": "string",
                "description": "Path the lane writes and that does not exist yet"
              },
              "modifies": {
                "type": "string",
                "description": "Path the lane writes and that already exists"
              },
              "tests": {
                "type": "string",
                "description": "Test file the lane owns"
              },
              "reads": {
                "type": "array",
                "items": { "type": "string" }
              },
              "must_not_touch": {
                "type": "array",
                "items": { "type": "string" }
              },
              "worktree": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "dispatch_order": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["criteria", "focus"],
                  "properties": {
                    "criteria": {
                      "type": "array",
                      "minItems": 1,
                      "items": { "type": "integer", "minimum": 1 }
                    },
                    "focus": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "additionalProperties": true
          },
          "boundaries": {
            "type": "array",
            "description": "Architectural boundaries this task crosses (SW-159-BP-CONTRACT-001). Optional: a task with no data-boundary change omits this and validates exactly as before. Every declared boundary is contract-requiring and must carry a complete data_contract.",
            "items": {
              "type": "object",
              "required": ["kind", "data_contract"],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["storage", "process", "adapter", "telemetry", "public-api"],
                  "description": "The contract-requiring boundary kind: storage (persistence), process (separate executing context), adapter (foreign system), telemetry (observational sink), public-api (published surface)."
                },
                "data_contract": {
                  "type": "object",
                  "description": "The exact versioned data contract for this crossing. All five fields are required and must be non-blank; a prose-only string is refused by validate_prd_data_boundaries.",
                  "required": ["artifact", "versioning", "producer", "consumer", "compatibility"],
                  "properties": {
                    "artifact": {
                      "type": "string",
                      "minLength": 1,
                      "description": "What crosses the boundary."
                    },
                    "versioning": {
                      "type": "string",
                      "minLength": 1,
                      "description": "How the artifact is versioned and which version is contracted."
                    },
                    "producer": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Who produces the artifact."
                    },
                    "consumer": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Who consumes the artifact."
                    },
                    "compatibility": {
                      "type": "string",
                      "minLength": 1,
                      "description": "How the consumer tolerates producer change (e.g. backward/forward compatible, breaking-with-migration)."
                    },
                    "subject_kind": {
                      "type": "string",
                      "enum": ["repository", "content", "configuration", "deployment", "incident"],
                      "description": "Optional. The integrated WorkContract subject kind (SW-159-WORK-001) the artifact's subject belongs to, so a boundary speaks the same vocabulary as the work contract that authorizes it."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "impact_if_wrong"],
        "properties": {
          "description": {
            "type": "string",
            "description": "Assumption description"
          },
          "impact_if_wrong": {
            "type": "string",
            "description": "Impact if assumption is incorrect"
          },
          "validation_method": {
            "type": "string",
            "description": "How to validate this assumption"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "timeline": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "budget": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "technical": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Technical constraints"
          }
        },
        "regulatory": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Regulatory constraints"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "external": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "owner", "timeline"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Dependency name"
              },
              "owner": {
                "type": "string",
                "description": "Owner/team responsible"
              },
              "timeline": {
                "type": "string",
                "description": "Expected timeline"
              },
              "risk_level": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              }
            }
          }
        },
        "internal": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["team", "deliverable"],
            "properties": {
              "team": {
                "type": "string",
                "description": "Internal team"
              },
              "deliverable": {
                "type": "string",
                "description": "What they need to deliver"
              },
              "due_date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "probability", "impact"],
        "properties": {
          "description": {
            "type": "string",
            "description": "Risk description"
          },
          "probability": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "description": "Probability of occurrence"
          },
          "impact": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Impact if occurs"
          },
          "mitigation": {
            "type": "string",
            "description": "Mitigation strategy"
          },
          "owner": {
            "type": "string",
            "description": "Risk owner"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "description": "Rolled-up effort/task counts across the whole PRD, produced by regen-sequence.py's tooling",
      "properties": {
        "tasks": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "execution_recommendation": {
      "type": "object",
      "description": "Recommended execution strategy based on complexity assessment",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["simple", "standard", "complex"],
          "description": "Recommended execution mode"
        },
        "reason": {
          "type": "string",
          "description": "Explanation for the recommendation"
        },
        "suggested_workflow": {
          "type": "string",
          "enum": ["rex-simple", "ralph-loop-attended", "ralph-loop-overnight", "direct-execution"],
          "description": "Suggested workflow type"
        },
        "estimated_iterations": {
          "type": "integer",
          "minimum": 1,
          "description": "Estimated number of iterations needed"
        },
        "parallel_opportunities": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of tasks that could run in parallel"
        },
        "recommended_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["planning", "code_generation", "testing", "review", "research", "automation", "infrastructure"]
          },
          "description": "Recommended agent capabilities for this project"
        },
        "complexity_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Complexity score (0-100)"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "projectName": "Todo API",
      "version": "1.0.0",
      "status": "draft",
      "tasks": [
        {
          "id": "INFRA-001",
          "title": "Set up project structure",
          "description": "Initialize repository with Express setup",
          "priority": "P0",
          "points": 3,
          "dependsOn": [],
          "acceptanceCriteria": [
            "package.json exists with Express dependencies",
            "tsconfig.json configured with strict mode",
            "src/index.ts exists with basic Express server",
            "npm run build compiles without errors",
            "npm test runs test suite"
          ],
          "type": "infrastructure",
          "passes": false,
          "lane": {
            "creates": "src/index.ts",
            "tests": "tests/test_index.ts",
            "reads": ["docs/README.md"],
            "must_not_touch": ["docs/templates/unified-mirror.yml"],
            "dispatch_order": [
              { "criteria": [1, 2, 3], "focus": "set up the package and the build" },
              { "criteria": [4, 5], "focus": "prove the build and tests are green" }
            ]
          }
        }
      ],
      "totals": {
        "tasks": 1,
        "points": 3
      }
    }
  ]
}