{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptSequence",
  "type": "object",
  "required": [
    "metadata",
    "objective",
    "success_criteria",
    "assumptions",
    "usage_notes",
    "inputs_required",
    "outputs_required",
    "sequence_steps",
    "final_assembly",
    "validation_rules",
    "failure_handling",
    "final_deliverable_format"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["plan", "build", "mixed"]
        },
        "domain": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "complexity": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        }
      },
      "additionalProperties": true
    },
    "objective": {
      "type": "string"
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usage_notes": {
      "type": "object"
    },
    "inputs_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sequence_steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "purpose",
          "instructions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": "string"
          },
          "expected_output": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completion_rule": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "final_assembly": {
      "type": "string"
    },
    "validation_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_handling": {
      "type": "string"
    },
    "final_deliverable_format": {
      "type": "string"
    },
    "methodology": {
      "type": "string",
      "enum": ["rex", "ralph", "gauntlet", "assay"],
      "description": "The execution methodology, named separately from its autonomy policy and session schedule (SW-1510-SKILLS). Assay is never silently substituted by Ralph: the value is carried verbatim."
    },
    "autonomy_policy": {
      "type": "string",
      "enum": ["conservative", "medium", "unicorn", ""],
      "description": "The autonomy policy on the methodology's own policy axis, carried as a separate field. 'unicorn' is Assay's declared default; the empty string means the methodology declares no autonomy policy and is never coerced to one."
    },
    "session_schedule": {
      "type": "string",
      "minLength": 1,
      "description": "The session scheduling, separate again from the methodology and the autonomy policy."
    },
    "execution_envelope": {
      "$ref": "#/$defs/executionEnvelope"
    }
  },
  "$defs": {
    "executionEnvelope": {
      "type": "object",
      "title": "execution-envelope-v1",
      "description": "The namespaced execution-envelope-v1 block (SW-1510-SKILLS). It carries methodology, autonomy_policy and session_schedule as three separate fields and records the explicit legacy adapter that produced it.",
      "required": ["version", "methodology", "autonomy_policy", "session_schedule"],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "The envelope version. A consumer refuses a version it does not know."
        },
        "methodology": {
          "type": "string",
          "enum": ["rex", "ralph", "gauntlet", "assay"]
        },
        "autonomy_policy": {
          "type": "string",
          "enum": ["conservative", "medium", "unicorn", ""]
        },
        "session_schedule": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": ["declared", "legacy"],
          "description": "'declared' when the methodology came from an explicit declaration; 'legacy' when it was adapted from the legacy execution_mode vocabulary."
        },
        "legacy_fields": {
          "type": "array",
          "items": {"type": "string"},
          "description": "The legacy fields the adapter consumed, recorded so a run can re-trace the compatibility path."
        },
        "subject_kind": {
          "type": "string",
          "enum": ["configuration"]
        },
        "schema_digest": {
          "type": "string",
          "description": "The exact canonical schema digest the envelope was compiled against, frozen before implementation."
        }
      },
      "additionalProperties": false
    }
  }
}