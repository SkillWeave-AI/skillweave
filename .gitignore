__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.env
.venv/
dist/
build/
*.egg-info/
install.log
strategy.md

# SkillWeave substrate — generated, local, never committed.
# What SkillWeave writes here (PRDs, specs, sequences, discovery findings,
# handover records) is IP, and this repository is publicly mirrored. See
# docs/substrate-map.md, invariant 5. Substrate content is tracked only in the
# private per-org planning repository.
#
# Anchored on purpose: this excludes THIS project's substrate and leaves the
# checked-in test fixture under tests/fixtures/substrate-root/.skillweave/
# tracked. Dropping the leading slash would swallow that fixture, and the suite
# would fail in CI while passing locally.
/.skillweave/

# Session state file (worktree-local, never committed)
.swci-state.md
.swroute-state.md

# Debug/exploration scripts and generated artifacts
*.debug*
prd-skillweave-*.json
prd-skillweave-*.md
generated/

# Release-gate run artifacts — output of the readiness gate, regenerated on every
# run (src/skillweave/github_integration/release_gate.py). Not source; never
# committed.
release-gate-data.json
release-gate-report.md

# External tool configurations (not part of SkillWeave)
.codenomad/
.cursor/

# Coverage
.coverage.worktrees/

# Repo-root hygiene (CORE-ZR-022). Scratch logs, ad-hoc scripts and the local
# evidence directories the verify harnesses write are never tracked. Anchored
# with a leading slash so a same-named tracked path deeper in the tree (for
# example the tests/fixtures substrate) is never swallowed by accident.
/*.log
/tests_output/
/tests_output_rework.txt
